{
  "name": "fashionapp",
  "module": "server/index.ts",
  "type": "module",
  "workspaces": ["frontend", "server", "shared", "mobile"],
  "overrides": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "scripts": {
